APP_NAME=Python Course Backend
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=app-files
# MINIO_ENDPOINT: nơi backend kết nối để upload — "localhost:9000" khi chạy BE trực tiếp
# trên máy (start-be.bat), đổi thành "minio:9000" khi chạy BE trong compose.yaml.
MINIO_ENDPOINT=localhost:9000
# MINIO_PUBLIC_ENDPOINT: nơi trình duyệt tải ảnh — luôn là địa chỉ máy host.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_USE_SSL=false

# PostgreSQL (mặc định khớp với infra/compose.dev.yaml khi chạy BE trực tiếp trên máy)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Tài khoản admin được tạo khi chạy `python -m app.scripts.seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@123

# JWT — dùng cho đăng ký/đăng nhập. Đổi JWT_SECRET_KEY khi deploy thật.
JWT_SECRET_KEY=dev-secret-key-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
