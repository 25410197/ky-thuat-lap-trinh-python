APP_NAME=Python Course Backend
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=app-files

# PostgreSQL (mặc định khớp với infra/compose.dev.yaml khi chạy BE trực tiếp trên máy)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
